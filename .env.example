# AdapterForge — variables de entorno (prefijo AF_, ver src/adapterforge/settings.py)
# Copia este fichero a .env y rellena lo que necesites. NUNCA subas .env al repo.

# --- Teacher / juez (formato litellm: "proveedor/modelo") ---------------------
# Teacher para la síntesis de dataset (Fase A). Ejemplos:
#   openai/gpt-4o-mini            (API OpenAI)
#   ollama/qwen3:8b               (Ollama local, sin coste de API)
AF_TEACHER_MODEL=openai/gpt-4o-mini
AF_JUDGE_MODEL=openai/gpt-4o-mini

# Endpoint OpenAI-compatible para inferencia/evaluación (vLLM, Ollama...).
# Desde un contenedor, el Ollama del host es http://host.docker.internal:11434/v1
AF_API_BASE=http://host.docker.internal:11434/v1
AF_API_KEY=

# Clave del proveedor del teacher (la lee litellm directamente del entorno).
OPENAI_API_KEY=

# --- Hugging Face -------------------------------------------------------------
# Token de Hugging Face: lectura para `make data-pull` (dataset privado
# Jaisato/juristune-datasets); escritura para publicar adapter/dataset/Space.
# AdapterForge lo lee de este .env (o del entorno) como HF_TOKEN o como
# AF_HF_TOKEN, que tiene prioridad: no hace falta exportarlo ni pasar --token.
HF_TOKEN=
AF_HF_REPO_ID=Jaisato/juristune-qwen3-4b-lora

# --- Tracking -----------------------------------------------------------------
AF_MLFLOW_TRACKING_URI=http://localhost:5000

# --- Rutas (opcionales, tienen defaults sensatos) ------------------------------
# AF_DATA_DIR=data
# AF_ARTIFACTS_DIR=artifacts
